// Resources of the CLI exe (CMake fills in the version and the absolute paths): the icon so both
// distributions carry the same branding, and the version information Explorer shows. Same VERSION
// source as the viewer - one version, everywhere.
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/viewer/res/cardbridge.ico"

1 VERSIONINFO
FILEVERSION @CARDBRIDGE_VERSION_RC@
PRODUCTVERSION @CARDBRIDGE_VERSION_RC@
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ryan Oktaviandi Susilo Wibowo"
      VALUE "LegalCopyright", "CardBridge by Ryan Oktaviandi Susilo Wibowo"
      VALUE "ProductName", "CardBridge"
      VALUE "FileDescription", "CardBridge: Koikatsu card to 3D workbench (command line)"
      VALUE "ProductVersion", "@CARDBRIDGE_VERSION@"
      VALUE "FileVersion", "@CARDBRIDGE_VERSION@"
      VALUE "OriginalFilename", "CardBridge-CLI.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
